diff --git a/src/qml/common/LegacyTableView.qml b/src/qml/common/LegacyTableView.qml
index 820762e..e80722e 100644
--- a/src/qml/common/LegacyTableView.qml
+++ b/src/qml/common/LegacyTableView.qml
@@ -1,10 +1,180 @@
-import QtQuick 2.0
-import QtQuick.Controls 1.4 as LC
-import "./platformutils.js" as PlatformUtils
-
-LC.TableView {
-    rowDelegate: Rectangle {
-        height: 30
-        color: styleData.selected ? sysPalette.highlight : styleData.alternate? sysPalette.alternateBase : "transparent"
+import QtQuick
+import QtQuick.Controls
+import "."
+
+/**
+  * Simple read-only table built on plain Qt Quick primitives.
+  *
+  * Qt 6 removed Qt Quick Controls 1 (and with it the old TableView /
+  * TableViewColumn pair), so this replaces the previous wrapper. Columns are
+  * declared as an array of descriptors instead of child objects:
+  *
+  *   LegacyTableView {
+  *       model: someListModel
+  *       columns: [
+  *           { role: "name",  title: qsTranslate("RESP", "Name"),  width: 200 },
+  *           { role: "value", title: qsTranslate("RESP", "Value"), width: 300,
+  *             formatter: function(value, row) { return value.toUpperCase() } }
+  *       ]
+  *   }
+  *
+  * A column may also provide a "delegate" Component for a custom cell; the
+  * component receives "cellValue" and "rowData" properties.
+  */
+Item {
+    id: root
+
+    property var model: []
+    property var columns: []
+    property int rowHeight: 30
+    property int headerHeight: 30
+    property bool headerVisible: true
+    property int currentRow: -1
+
+    readonly property int rowCount: list.count
+
+    implicitWidth: 200
+    implicitHeight: 100
+
+    function _columnWidth(column) {
+        return column && column.width ? column.width : 100
+    }
+
+    function _cellText(column, value, rowData) {
+        if (value === undefined || value === null)
+            return ""
+
+        if (column.formatter)
+            return column.formatter(value, rowData)
+
+        return "" + value
+    }
+
+    Rectangle {
+        id: header
+
+        visible: root.headerVisible
+        anchors.top: parent.top
+        anchors.left: parent.left
+        anchors.right: parent.right
+        height: root.headerVisible ? root.headerHeight : 0
+        color: sysPalette.button
+
+        Row {
+            anchors.fill: parent
+
+            Repeater {
+                model: root.columns
+
+                Rectangle {
+                    width: root._columnWidth(modelData)
+                    height: header.height
+                    color: sysPalette.button
+                    border.color: sysPalette.mid
+                    border.width: 1
+
+                    BetterLabel {
+                        anchors.fill: parent
+                        anchors.leftMargin: 5
+                        anchors.rightMargin: 5
+                        verticalAlignment: Text.AlignVCenter
+                        elide: Text.ElideRight
+                        text: modelData.title ? modelData.title : ""
+                    }
+                }
+            }
+        }
+    }
+
+    ListView {
+        id: list
+
+        anchors.top: header.visible ? header.bottom : parent.top
+        anchors.left: parent.left
+        anchors.right: parent.right
+        anchors.bottom: parent.bottom
+
+        clip: true
+        model: root.model
+
+        delegate: Item {
+            id: rowItem
+
+            width: list.width
+            height: root.rowHeight
+
+            // A JS array model hands over the row object as modelData, while an
+            // QAbstractItemModel exposes its roles on the delegate's model.
+            property var rowModel: model
+            property var rowData: (modelData !== undefined && modelData !== null
+                                   && typeof modelData === "object") ? modelData : null
+            property int rowIndex: index
+            property bool isCurrent: root.currentRow === index
+
+            Rectangle {
+                anchors.fill: parent
+                color: rowItem.isCurrent ? sysPalette.highlight
+                                         : (index % 2 ? sysPalette.alternateBase : "transparent")
+            }
+
+            Row {
+                anchors.fill: parent
+
+                Repeater {
+                    model: root.columns
+
+                    Item {
+                        id: cell
+
+                        width: root._columnWidth(modelData)
+                        height: rowItem.height
+
+                        property var columnDefinition: modelData
+                        property var cellValue: {
+                            if (rowItem.rowData)
+                                return rowItem.rowData[modelData.role]
+
+                            var rowModel = rowItem.rowModel
+                            return rowModel ? rowModel[modelData.role] : undefined
+                        }
+
+                        Loader {
+                            anchors.fill: parent
+                            sourceComponent: cell.columnDefinition.delegate
+
+                            onLoaded: {
+                                if (item) {
+                                    if (item.hasOwnProperty("cellValue"))
+                                        item.cellValue = cell.cellValue
+                                    if (item.hasOwnProperty("rowData"))
+                                        item.rowData = rowItem.rowData
+                                    if (item.hasOwnProperty("rowIndex"))
+                                        item.rowIndex = rowItem.rowIndex
+                                    if (item.hasOwnProperty("columnRole"))
+                                        item.columnRole = cell.columnDefinition.role
+                                }
+                            }
+                        }
+
+                        BetterLabel {
+                            anchors.fill: parent
+                            anchors.leftMargin: 5
+                            anchors.rightMargin: 5
+                            verticalAlignment: Text.AlignVCenter
+                            elide: cell.columnDefinition.elideMode !== undefined
+                                   ? cell.columnDefinition.elideMode : Text.ElideRight
+                            visible: !cell.columnDefinition.delegate
+                            text: root._cellText(cell.columnDefinition, cell.cellValue, rowItem.rowData)
+                        }
+
+                        MouseArea {
+                            anchors.fill: parent
+                            enabled: cell.columnDefinition.delegate === undefined
+                            onClicked: root.currentRow = rowItem.rowIndex
+                        }
+                    }
+                }
+            }
+        }
     }
 }
