+// Qt 6 removed QByteArray::contains(QRegExp), so the filter (a wildcard
+// pattern in every calling site) is matched through QRegularExpression.
+bool keyNameMatchesFilter(const QString &keyName, const QRegExp &filter) {
+    const QString pattern =
+        (filter.patternSyntax() == QRegExp::Wildcard)
+            ? QRegularExpression::wildcardToRegularExpression(filter.pattern())
+            : filter.pattern();
+    const QRegularExpression::PatternOptions options =
+        (filter.caseSensitivity() == Qt::CaseInsensitive)
+            ? QRegularExpression::CaseInsensitiveOption
+            : QRegularExpression::NoPatternOption;
+    return QRegularExpression(pattern, options).match(keyName).hasMatch();
+}
